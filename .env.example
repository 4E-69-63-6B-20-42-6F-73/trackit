# Empty uses the current origin. Set an absolute URL when the API is hosted separately.
VITE_API_URL=

# Server settings
TRACKIT_ORIGIN=http://localhost:3000
TRACKIT_PORT=3000
TRACKIT_BIND_ADDRESS=0.0.0.0
TRACKIT_DB_PASSWORD=replace-with-a-random-password
# Set true only when TrackIt is reachable exclusively through your trusted reverse proxy.
TRACKIT_TRUST_PROXY=false

# Generate with: openssl rand -base64 32
# Store this key separately from the backup volume. Losing it makes archives unrecoverable.
TRACKIT_BACKUPS_ENABLED=false
TRACKIT_BACKUP_KEY=

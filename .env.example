# Empty uses the current origin. Set an absolute URL when the API is hosted separately.
VITE_API_URL=

# Server settings
TRACKIT_ORIGIN=http://localhost:3000
TRACKIT_PORT=3000
TRACKIT_BIND_ADDRESS=127.0.0.1
TRACKIT_DB_PASSWORD=replace-with-a-random-password
# Required only for initial owner creation. Generate at least 32 random characters.
TRACKIT_BOOTSTRAP_SECRET=replace-with-a-random-bootstrap-secret
# Set true only when TrackIt is reachable exclusively through your trusted reverse proxy.
TRACKIT_TRUST_PROXY=false
# General authenticated API requests allowed per client each minute. Login and recovery remain
# separately restricted to 5 attempts per minute.
TRACKIT_API_RATE_LIMIT_MAX=600

# Generate with: openssl rand -base64 32
# Store this key separately from the backup volume. Losing it makes archives unrecoverable.
TRACKIT_BACKUPS_ENABLED=false
TRACKIT_BACKUP_KEY=

# Optional food catalog adapter. No external catalog is contacted unless configured.
# Open Food Facts compatible example: https://world.openfoodfacts.org
FOOD_CATALOG_URL=

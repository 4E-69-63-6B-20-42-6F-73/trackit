{
    "name": "trackit",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "start": "docker compose up --build",
        "dev": "vite",
        "dev:server": "tsx watch server/index.ts",
        "build": "tsc -b && tsc -p tsconfig.server.json && vite build && node scripts/check-bundle.mjs",
        "start:server": "tsx server/index.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx server/db/migrate.ts",
        "backup:restore": "tsx server/backup/restore.ts",
        "backup:create": "tsx server/backup/create.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:android": "node scripts/android-check.mjs",
        "security:secrets": "node scripts/scan-secrets.mjs",
        "security:deps": "npm audit --omit=dev --audit-level=high",
        "check": "npm run format:check && npm run lint && npm run security:secrets && npm run test && npm run build",
        "preview": "vite preview"
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.2",
        "@fastify/cors": "^11.3.0",
        "@fastify/csrf-protection": "^8.0.1",
        "@fastify/helmet": "^13.1.1",
        "@fastify/rate-limit": "^11.2.0",
        "@fastify/static": "^10.1.3",
        "@mantine/core": "latest",
        "@mantine/hooks": "latest",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@node-rs/argon2": "^2.1.0",
        "@simplewebauthn/browser": "^13.3.0",
        "@simplewebauthn/server": "^13.3.2",
        "@tabler/icons-react": "latest",
        "dayjs": "latest",
        "drizzle-orm": "^0.45.2",
        "fastify": "^5.12.1",
        "postgres": "^3.4.9",
        "qrcode.react": "^4.2.0",
        "react": "latest",
        "react-dom": "latest",
        "react-router-dom": "^7.18.2",
        "recharts": "latest",
        "tsx": "^4.23.12",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@electric-sql/pglite": "^0.5.5",
        "@eslint/js": "latest",
        "@playwright/test": "^1.62.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.5",
        "@types/node": "^26.2.0",
        "@types/react": "latest",
        "@types/react-dom": "latest",
        "@vitejs/plugin-react": "latest",
        "drizzle-kit": "^0.31.10",
        "eslint": "latest",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "latest",
        "eslint-plugin-react-refresh": "latest",
        "globals": "latest",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.6",
        "typescript": "latest",
        "typescript-eslint": "latest",
        "vite": "latest",
        "vitest": "^4.1.11"
    }
}

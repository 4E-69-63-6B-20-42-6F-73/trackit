{
    "name": "trackit",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "start": "docker compose up --build",
        "dev": "npm run dev:web",
        "predev:web": "npm run build:domain",
        "dev:web": "vite",
        "predev:api": "npm run build:domain",
        "dev:api": "tsx -env-file=.env watch server/index.ts",
        "dev:db": "docker compose -f compose.yaml -f compose.dev.yaml up -d db",
        "prestart:server": "npm run build:domain",
        "start:server": "tsx server/index.ts",
        "build:domain": "npm run build --workspace @trackit/domain",
        "preapi:types": "npm run build:domain",
        "api:types": "tsx scripts/generate-api-types.ts",
        "preapi:types:check": "npm run build:domain",
        "api:types:check": "tsx scripts/generate-api-types.ts --check",
        "prebuild": "npm run api:types",
        "build": "tsc -b && tsc -p tsconfig.server.json && tsc -p tsconfig.runtime.json && vite build && node scripts/check-bundle.mjs",
        "db:generate": "drizzle-kit generate",
        "db:check": "drizzle-kit check",
        "db:migrate": "tsx server/db/migrate.ts",
        "db:migrate:local": "tsx --env-file=.env server/db/migrate.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "npx --yes prettier@3.9.6 --write .",
        "format:check": "npx --yes prettier@3.9.6 --check .",
        "pretest": "npm run build:domain",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:android": "node scripts/android-check.mjs",
        "install:android": "adb install android/app/build/outputs/apk/debug/app-debug.apk",
        "build:android": "node scripts/android-build.mjs",
        "security:secrets": "node scripts/scan-secrets.mjs",
        "security:deps": "npm audit --omit=dev --audit-level=high",
        "check": "npm run format:check && npm run lint && npm run db:check && npm run security:secrets && npm run api:types:check && npm run test && npm run build",
        "preview": "vite preview"
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.2",
        "@fastify/cors": "^11.3.0",
        "@fastify/csrf-protection": "^8.0.1",
        "@fastify/helmet": "^13.1.1",
        "@fastify/rate-limit": "^11.2.0",
        "@fastify/static": "^10.1.3",
        "@fastify/swagger": "^9.8.1",
        "@mantine/core": "9.5.1",
        "@mantine/hooks": "9.5.1",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@node-rs/argon2": "^2.1.0",
        "@simplewebauthn/browser": "^13.3.0",
        "@simplewebauthn/server": "^13.3.2",
        "@tabler/icons-react": "3.46.0",
        "@tanstack/react-query": "^5.102.8",
        "dayjs": "1.11.23",
        "drizzle-orm": "^0.45.2",
        "fastify": "^5.12.1",
        "fastify-type-provider-zod": "^7.0.0",
        "openapi-fetch": "^0.17.0",
        "openapi-react-query": "^0.5.4",
        "postgres": "^3.4.9",
        "qrcode.react": "^4.2.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-router-dom": "^7.18.2",
        "recharts": "3.10.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@electric-sql/pglite": "^0.5.5",
        "@eslint/js": "10.0.1",
        "@playwright/test": "^1.62.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.5",
        "@types/node": "^26.2.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "6.1.0",
        "drizzle-kit": "^0.31.10",
        "eslint": "10.9.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.4",
        "globals": "17.11.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.67.0",
        "vite": "8.2.2",
        "vitest": "^4.1.11"
    }
}
